#!/usr/bin/env bash
# homelab — GitOps manager for rootless Podman compose stacks.
#
# Every directory in stacks/ that contains a compose.yml is one stack. The git
# repo is the source of truth: `homelab sync` (run by a systemd timer) pulls new
# commits and applies only the stacks whose files changed. Removed stacks are
# taken down (their data is kept).
#
# Run `./homelab help` for commands.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
STACKS_DIR="$ROOT/stacks"
LOCAL_CONF="$ROOT/.homelab.env"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
export PATH="$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PODMAN_SOCK="$XDG_RUNTIME_DIR/podman/podman.sock"

# ---------------------------------------------------------------- utilities --

if [[ -t 1 ]]; then B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B= G= Y= R= N=; fi
log()  { printf '%s==>%s %s\n' "$B$G" "$N" "$*"; }
warn() { printf '%swarn:%s %s\n' "$B$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$B$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Settings: homelab.conf (tracked, shared defaults) is overridden by .homelab.env
# (gitignored, this machine only). `bootstrap` saves any HOMELAB_* variable you
# pass on its command line into .homelab.env, e.g. HOMELAB_MEDIA=/srv/media ./bootstrap.sh
CONF_VARS=(HOMELAB_DATA HOMELAB_MEDIA HOMELAB_SYNC_INTERVAL HOMELAB_PORTS HOMELAB_HOST)
SHARED_CONF="$ROOT/homelab.conf"

save_conf_overrides() {
  local v
  for v in "${CONF_VARS[@]}"; do
    [[ -n ${!v:-} ]] || continue
    touch "$LOCAL_CONF"
    sed -i "/^$v=/d" "$LOCAL_CONF"
    printf '%s=%q\n' "$v" "${!v}" >>"$LOCAL_CONF"
    log "saved $v=${!v} to .homelab.env"
  done
}

load_local_conf() {
  # shellcheck disable=SC1090
  [[ -f $SHARED_CONF ]] && source "$SHARED_CONF"
  # shellcheck disable=SC1090
  [[ -f $LOCAL_CONF ]] && source "$LOCAL_CONF"
  : "${HOMELAB_DATA:=$HOME/homelab-data}" "${HOMELAB_MEDIA:=$HOME/media}" "${HOMELAB_SYNC_INTERVAL:=5min}"
  : "${HOMELAB_PORTS:=10000:10099}"
}

# This machine's LAN address, for links shown to people (HOMELAB_HOST overrides
# it): the source address of the default route, so not a container bridge.
lan_host() {
  [[ -n ${HOMELAB_HOST:-} ]] && { echo "$HOMELAB_HOST"; return; }
  local ip
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
  [[ -n $ip ]] || ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo "${ip:-localhost}"
}

# All stacks currently defined in the working tree, sorted.
all_stacks() {
  local f
  for f in "$STACKS_DIR"/*/compose.yml; do
    [[ -e $f ]] && basename "$(dirname "$f")"
  done
}

resolve_stacks() { # args → validated stack names (default: all)
  if (($# == 0)); then all_stacks; return; fi
  local s
  for s in "$@"; do
    [[ -f $STACKS_DIR/$s/compose.yml ]] || die "unknown stack '$s' (have: $(all_stacks | tr '\n' ' '))"
    echo "$s"
  done
}

# Pick a compose implementation. docker-compose talks to Podman via DOCKER_HOST,
# which also keeps it away from any Docker daemon running on the same machine.
COMPOSE=()
find_compose() {
  ((${#COMPOSE[@]})) && return
  if have docker-compose; then COMPOSE=(docker-compose)
  elif have docker && docker compose version >/dev/null 2>&1; then COMPOSE=(docker compose)
  elif have podman-compose; then COMPOSE=(podman-compose)
  else die "no compose tool found; run ./bootstrap.sh to install one"
  fi
}

compose() { # compose <stack> <args...>
  local s=$1; shift
  find_compose
  DOCKER_HOST="unix://$PODMAN_SOCK" "${COMPOSE[@]}" \
    --project-name "$s" --project-directory "$STACKS_DIR/$s" \
    -f "$STACKS_DIR/$s/compose.yml" "$@"
}

ensure_socket() {
  [[ -S $PODMAN_SOCK ]] && return
  systemctl --user enable --now podman.socket >/dev/null 2>&1 || true
  [[ -S $PODMAN_SOCK ]] || die "Podman API socket not available at $PODMAN_SOCK (try: systemctl --user enable --now podman.socket)"
}

# --------------------------------------------------------- env generation --

random_secret() { LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32 || true; }

host_tz() {
  timedatectl show -p Timezone --value 2>/dev/null \
    || { [[ -f /etc/timezone ]] && cat /etc/timezone; } \
    || echo Etc/UTC
}

# Render stacks/<s>/.env.example into stacks/<s>/.env. Existing values are never
# touched; keys added to the example later are appended. Placeholders:
#   {{DATA}}   → $HOMELAB_DATA/<stack>     {{HOME}} → $HOME
#   {{MEDIA}}  → $HOMELAB_MEDIA (shared media root, not per stack)
#   {{TZ}}     → host timezone             {{UID}}/{{GID}} → your ids
#   {{RANDOM}} → a fresh 32-char alphanumeric secret
# Values that use {{DATA}}, {{MEDIA}} or {{HOME}} are paths and get created as
# directories.
ensure_env() {
  local s=$1 example="$STACKS_DIR/$1/.env.example" env="$STACKS_DIR/$1/.env"
  [[ -f $example ]] || return 0
  [[ -f $env ]] || { : >"$env"; chmod 600 "$env"; log "$s: generating .env"; }
  local line key val tz
  tz=$(host_tz)
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
    grep -q "^$key=" "$env" && continue
    local is_path=0
    [[ $val == *'{{DATA}}'* || $val == *'{{MEDIA}}'* || $val == *'{{HOME}}'* ]] && is_path=1
    val=${val//'{{DATA}}'/$HOMELAB_DATA/$s}
    val=${val//'{{MEDIA}}'/$HOMELAB_MEDIA}
    val=${val//'{{HOME}}'/$HOME}
    val=${val//'{{TZ}}'/$tz}
    val=${val//'{{UID}}'/$(id -u)}
    val=${val//'{{GID}}'/$(id -g)}
    while [[ $val == *'{{RANDOM}}'* ]]; do val=${val/'{{RANDOM}}'/$(random_secret)}; done
    printf '%s=%s\n' "$key" "$val" >>"$env"
    if ((is_path)); then
      mkdir -p "$val" || die "$s: cannot create $val (set HOMELAB_DATA / HOMELAB_MEDIA in .homelab.env)"
    fi
  done <"$example"
  return 0
}

# ------------------------------------------------------------- operations --

# stack_up <stack> [--pull | --sync]
#   --pull  pull newer images first
#   --sync  pull, then recreate containers even if compose sees no change, so
#           edits to mounted files take effect
# Hooks: pre-up runs before `compose up` (a failure aborts the stack, e.g. it
# renders config files); post-up runs after it (a failure only warns).
# Errors are checked explicitly: callers use `stack_up ... || warn`, which
# turns off `set -e` inside the function.
stack_up() {
  local s=$1 mode=${2:-} up_args=(-d --remove-orphans)
  ensure_env "$s" || return 1
  if [[ $mode == --pull || $mode == --sync ]]; then
    log "$s: pulling images"
    compose "$s" pull --quiet || return 1
  fi
  [[ $mode == --sync ]] && up_args+=(--force-recreate)
  run_hook "$s" pre-up || return 1
  log "$s: up"
  compose "$s" up "${up_args[@]}" || return 1
  run_hook "$s" post-up || true
}

# Optional, idempotent per-stack hook (stacks/<stack>/pre-up or post-up): runs
# from the stack directory with homelab.conf, .homelab.env and the stack's .env
# exported, plus HOMELAB_HOST (see lan_host). Returns the hook's status (after
# warning on failure).
run_hook() {
  local s=$1 hook="$STACKS_DIR/$1/$2" rc=0
  [[ -x $hook ]] || return 0
  log "$s: running $2 hook"
  (
    cd "$STACKS_DIR/$s"
    set -a
    # shellcheck disable=SC1090,SC1091
    [[ -f $SHARED_CONF ]] && source "$SHARED_CONF"
    # shellcheck disable=SC1090
    [[ -f $LOCAL_CONF ]] && source "$LOCAL_CONF"
    HOMELAB_HOST=$(lan_host)
    # shellcheck disable=SC1091
    [[ -f .env ]] && source .env
    set +a
    "$hook"
  ) || rc=$?
  ((rc == 0)) || warn "$s: $2 hook failed"
  return $rc
}

stack_down() { # works even when the stack's files are gone from the repo
  local s=$1
  log "$s: down (volumes and data are kept)"
  find_compose
  if [[ -f $STACKS_DIR/$s/compose.yml ]]; then
    compose "$s" down --remove-orphans
  else
    DOCKER_HOST="unix://$PODMAN_SOCK" "${COMPOSE[@]}" --project-name "$s" down --remove-orphans
  fi
}

up_stacks() { # up_stacks <mode> <stack...>: keeps going if one stack fails
  local mode=$1 s rc=0; shift
  for s in "$@"; do stack_up "$s" "$mode" || { warn "$s: failed (see output above)"; rc=1; }; done
  return $rc
}
cmd_up()      { ensure_socket; load_local_conf; up_stacks "" $(resolve_stacks "$@"); }
cmd_update()  { ensure_socket; load_local_conf; up_stacks --pull $(resolve_stacks "$@"); }
cmd_down()    { ensure_socket; local s; for s in $(resolve_stacks "$@"); do stack_down "$s"; done; }
cmd_restart() { ensure_socket; local s; for s in $(resolve_stacks "$@"); do compose "$s" restart; done; }
cmd_logs()    { [[ $# -ge 1 ]] || die "usage: homelab logs <stack> [service]"; local s=$1; shift; resolve_stacks "$s" >/dev/null; compose "$s" logs -f --tail=100 "$@"; }
cmd_compose() { [[ $# -ge 1 ]] || die "usage: homelab compose <stack> <compose args...>"; local s=$1; shift; resolve_stacks "$s" >/dev/null; compose "$s" "$@"; }

cmd_status() {
  ensure_socket
  local s
  {
    printf 'STACK\tCONTAINER\tSTATUS\n'
    for s in $(all_stacks); do
      podman ps -a --filter "label=com.docker.compose.project=$s" --format "$s"$'\t{{.Names}}\t{{.Status}}' | sort -k2
    done
  } | column -t -s $'\t'
  echo
  if systemctl --user is-active -q homelab-sync.timer 2>/dev/null; then
    echo "autosync: on  (next: $(systemctl --user list-timers homelab-sync.timer --no-legend | awk '{print $2, $3}'))"
  else
    echo "autosync: off"
  fi
  echo "revision: $(git -C "$ROOT" log -1 --format='%h %s (%cr)' 2>/dev/null || echo 'n/a')"
}

# Pull new commits from the upstream branch and apply what changed.
cmd_sync() {
  cd "$ROOT"
  git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || { warn "branch has no upstream; nothing to sync"; return 0; }
  git fetch --quiet
  local old new
  old=$(git rev-parse HEAD) new=$(git rev-parse '@{u}')
  if [[ $old == "$new" ]]; then echo "up to date at ${old:0:7}"; return 0; fi
  if ! git merge-base --is-ancestor "$old" "$new"; then
    die "local branch has diverged from upstream; resolve manually (sync only fast-forwards)"
  fi
  git merge --ff-only --quiet '@{u}' || die "fast-forward failed (uncommitted local changes?)"
  log "updated ${old:0:7} → ${new:0:7}"
  # Re-exec so the apply step runs with the freshly pulled version of this script.
  exec "$ROOT/homelab" apply "$old" "$new"
}

# Apply the stack changes between two commits (used by sync).
cmd_apply() {
  [[ $# -eq 2 ]] || die "usage: homelab apply <old-rev> <new-rev>"
  ensure_socket; load_local_conf
  local s changed rc=0
  changed=$(git -C "$ROOT" diff --name-only "$1" "$2" -- stacks/ | awk -F/ 'NF>2 {print $2}' | sort -u)
  # Shared settings (domain, paths, ports) can affect any stack: re-apply all.
  if ! git -C "$ROOT" diff --quiet "$1" "$2" -- homelab.conf; then
    log "homelab.conf changed: re-applying every stack"
    changed=$( { echo "$changed"; all_stacks; } | grep -v '^$' | sort -u)
  fi
  [[ -n $changed ]] || { echo "no stack changes"; return 0; }
  for s in $changed; do
    if [[ -f $STACKS_DIR/$s/compose.yml ]]; then
      stack_up "$s" --sync || { warn "$s: failed to apply"; rc=1; }
    else
      stack_down "$s" || { warn "$s: failed to take down"; rc=1; }
    fi
  done
  return $rc
}

cmd_autosync() {
  case ${1:-status} in
    on)
      load_local_conf
      mkdir -p "$UNIT_DIR"
      cat >"$UNIT_DIR/homelab-sync.service" <<EOF
[Unit]
Description=Homelab GitOps sync ($ROOT)
Wants=network-online.target
After=network-online.target podman.socket

[Service]
Type=oneshot
WorkingDirectory=$ROOT
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$ROOT/homelab sync
EOF
      cat >"$UNIT_DIR/homelab-sync.timer" <<EOF
[Unit]
Description=Run homelab GitOps sync every $HOMELAB_SYNC_INTERVAL

[Timer]
OnBootSec=2min
OnUnitActiveSec=$HOMELAB_SYNC_INTERVAL
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now homelab-sync.timer >/dev/null
      log "autosync on: every $HOMELAB_SYNC_INTERVAL (logs: journalctl --user -u homelab-sync)"
      ;;
    off)
      systemctl --user disable --now homelab-sync.timer >/dev/null 2>&1 || true
      log "autosync off"
      ;;
    status) systemctl --user list-timers homelab-sync.timer --no-pager ;;
    *) die "usage: homelab autosync on|off|status" ;;
  esac
}

# One-shot host setup + deploy. Idempotent: safe to re-run at any time.
cmd_bootstrap() {
  log "checking prerequisites"
  if ! have podman; then
    if have apt-get; then log "installing podman (sudo)"; sudo apt-get update -qq && sudo apt-get install -y podman
    elif have dnf; then log "installing podman (sudo)"; sudo dnf install -y podman
    else die "please install podman first"
    fi
  fi
  have git || die "please install git"
  find_compose 2>/dev/null || install_compose

  log "enabling Podman API socket and container auto-start"
  systemctl --user enable --now podman.socket >/dev/null
  systemctl --user enable podman-restart.service >/dev/null 2>&1 || warn "could not enable podman-restart.service"
  # Linger starts user services at boot, before anyone logs in.
  if [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) != yes ]]; then
    loginctl enable-linger "$USER" 2>/dev/null || sudo loginctl enable-linger "$USER" \
      || warn "could not enable linger; containers will start at login instead of at boot"
  fi

  save_conf_overrides
  load_local_conf
  mkdir -p "$HOMELAB_DATA" || die "cannot create $HOMELAB_DATA"
  mkdir -p "$HOMELAB_MEDIA" || die "cannot create $HOMELAB_MEDIA (set HOMELAB_MEDIA, e.g. HOMELAB_MEDIA=~/media ./bootstrap.sh)"
  log "data directory:  $HOMELAB_DATA"
  log "media directory: $HOMELAB_MEDIA"
  open_firewall
  enable_gpu_access
  enable_power_control
  cmd_up || warn "some stacks did not start; fix them and run ./homelab up"
  if git -C "$ROOT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    cmd_autosync on
  else
    warn "no git upstream configured; autosync not enabled (push to a remote, then: ./homelab autosync on)"
  fi
  echo
  cmd_status
  print_urls
}

# If ufw is active it drops incoming traffic by default, which hides every
# service from other devices. Allow the homelab port range from the local
# subnet only (needs sudo; ufw skips rules that already exist).
open_firewall() {
  have ufw && systemctl is-active -q ufw 2>/dev/null || return 0
  grep -q '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null || return 0
  local dev subnet
  dev=$(ip -4 route show default 2>/dev/null | awk '{print $5; exit}')
  subnet=$(ip -4 route show dev "$dev" scope link proto kernel 2>/dev/null | awk '{print $1; exit}')
  if [[ -z $subnet ]]; then warn "could not detect the LAN subnet; open ports $HOMELAB_PORTS in ufw yourself"; return 0; fi
  log "firewall: allowing tcp $HOMELAB_PORTS from $subnet (sudo)"
  sudo ufw allow from "$subnet" to any port "$HOMELAB_PORTS" proto tcp comment 'homelab web UIs (LAN only)' >/dev/null \
    || warn "could not update ufw; other devices may not reach the services"
}

# Rootless containers reach the iGPU render node as the host user. By default
# only the "render" group and whoever is active on the physical seat (a logind
# ACL) may open it, so hardware transcoding breaks whenever nobody is logged in
# at the console. Render nodes give compute/video access only, not the display.
GPU_RULE=/etc/udev/rules.d/70-homelab-gpu.rules
enable_gpu_access() {
  compgen -G '/dev/dri/renderD*' >/dev/null || return 0
  grep -qs 'renderD' "$GPU_RULE" && return 0
  log "iGPU: letting rootless containers use /dev/dri/renderD* (sudo)"
  printf '%s\n' \
    '# Installed by modulab bootstrap: lets rootless containers (Jellyfin, Immich)' \
    '# use the iGPU for hardware transcoding regardless of who is logged in.' \
    'SUBSYSTEM=="drm", KERNEL=="renderD*", MODE="0666"' |
    sudo tee "$GPU_RULE" >/dev/null &&
    sudo udevadm control --reload &&
    sudo udevadm trigger --subsystem-match=drm --action=change ||
    warn "could not install $GPU_RULE; hardware transcoding may not work"
}

# The dashboard's Shut down / Restart buttons (stacks/dashboard/power) run as
# this user without a login session, which logind only lets power off after a
# password prompt. This polkit rule allows it for this user, without asking.
POWER_RULE=/etc/polkit-1/rules.d/50-homelab-power.rules
can_power_off() { # logind's answer as seen from the user manager, like the agent
  systemd-run --user --wait --pipe -q busctl call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager CanPowerOff 2>/dev/null | cut -d'"' -f2
}
enable_power_control() {
  [[ -f $STACKS_DIR/dashboard/compose.yml ]] || return 0
  [[ $(can_power_off) == yes ]] && return 0
  log "power buttons: allowing $USER to shut down and restart without a password (sudo)"
  sudo tee "$POWER_RULE" >/dev/null <<RULE || { warn "could not install $POWER_RULE; the dashboard's power buttons won't work"; return 0; }
// Installed by modulab bootstrap: lets $USER shut down and restart the machine
// without a password prompt (the dashboard's power buttons, stacks/dashboard/power).
polkit.addRule(function (action, subject) {
  var allowed = [
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.power-off-multiple-sessions",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.reboot-multiple-sessions"
  ];
  if (subject.user == "$USER" && allowed.indexOf(action.id) >= 0) return polkit.Result.YES;
});
RULE
  sleep 1 # polkit reloads rules.d on change
  [[ $(can_power_off) == yes ]] || warn "polkit rule installed, but logind still refuses; see $POWER_RULE"
}

install_compose() {
  local arch url dest="$HOME/.local/bin/docker-compose"
  case $(uname -m) in x86_64) arch=x86_64 ;; aarch64|arm64) arch=aarch64 ;; *) die "unsupported arch $(uname -m)" ;; esac
  url="https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$arch"
  log "installing docker-compose to $dest"
  mkdir -p "$(dirname "$dest")"
  local tmp; tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/docker-compose-linux-$arch" "$url"
  curl -fsSL -o "$tmp/sum" "$url.sha256"
  (cd "$tmp" && sha256sum -c sum >/dev/null) || die "docker-compose checksum mismatch"
  install -m 755 "$tmp/docker-compose-linux-$arch" "$dest"
  rm -rf "$tmp"
  COMPOSE=("$dest")
}

print_urls() {
  local host; host=$(lan_host)
  echo
  echo "${B}Services${N}"
  [[ -f $STACKS_DIR/dashboard/compose.yml ]] && echo "  Dashboard  http://$host:10004   (every app and its health)"
  [[ -f $STACKS_DIR/portainer/compose.yml ]] && echo "  Portainer  https://$host:10000  (user: admin, password: ./homelab secret portainer)"
  [[ -f $STACKS_DIR/immich/compose.yml ]]    && echo "  Immich     http://$host:10002   (modulab@modulab / modulab)"
  [[ -f $STACKS_DIR/jellyfin/compose.yml ]]  && echo "  Jellyfin   http://$host:10001   (modulab / modulab)"
  [[ -f $STACKS_DIR/futo-notes/compose.yml ]] && echo "  FUTO Notes http://$host:10003   (sync password: ./homelab secret futo-notes)"
  echo "  Podman Desktop: Containers tab (rootless Podman engine)"
}

cmd_secret() {
  local key
  case ${1:-} in
    portainer)  key=PORTAINER_ADMIN_PASSWORD ;;
    futo-notes) key=FUTO_NOTES_PASSWORD ;;
    *) die "usage: homelab secret portainer|futo-notes" ;;
  esac
  grep "^$key=" "$STACKS_DIR/$1/.env" | cut -d= -f2-
}

usage() {
  cat <<EOF
Usage: ./homelab <command> [stack...]

  bootstrap         set up this machine and deploy all stacks (idempotent)
  up [stack...]     create/update stacks (default: all)
  update [stack...] pull newer images, then up
  down [stack...]   stop and remove containers (data is kept)
  restart [stack..] restart containers
  status            show containers, autosync state and git revision
  logs <stack> [s]  follow logs
  compose <stack> … run any compose command against a stack
  sync              pull from git and apply changed stacks (what the timer runs)
  autosync on|off   install/remove the systemd sync timer
  secret <stack>    print a generated password (portainer, futo-notes)
  urls              print service URLs

Stacks: $(all_stacks | tr '\n' ' ')
EOF
}

case ${1:-help} in
  bootstrap) shift; cmd_bootstrap "$@" ;;
  up)        shift; cmd_up "$@" ;;
  update)    shift; cmd_update "$@" ;;
  down)      shift; cmd_down "$@" ;;
  restart)   shift; cmd_restart "$@" ;;
  status|ps) shift; cmd_status ;;
  logs)      shift; cmd_logs "$@" ;;
  compose)   shift; cmd_compose "$@" ;;
  sync)      shift; cmd_sync ;;
  apply)     shift; cmd_apply "$@" ;;
  autosync)  shift; cmd_autosync "$@" ;;
  secret)    shift; cmd_secret "$@" ;;
  urls)      load_local_conf; print_urls ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
