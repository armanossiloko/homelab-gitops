# Rendered to .env by ./homelab (see "Placeholders" in README.md).
# OC_URL (https://files.<HOMELAB_DOMAIN>) is added by the pre-up hook.

# Generated config (opencloud.yaml: secrets and IDs). Keep it with the data.
OPENCLOUD_CONFIG={{DATA}}/config

# Everyone's files, on the media SSD. OpenCloud manages this folder itself
# (files are stored by ID, not by name), so don't copy files into it by hand.
OPENCLOUD_DATA={{MEDIA}}/files

# Password of the `admin` account, applied on the first start only. The
# server is on the internet, so it's random. Show it: ./homelab secret opencloud
OPENCLOUD_ADMIN_PASSWORD={{RANDOM}}
