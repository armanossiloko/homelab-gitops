# Rendered to .env by ./homelab (see "Placeholders" in README.md).

# SQLite database and encrypted blobs
FUTO_NOTES_DATA={{DATA}}

# Sync password the FUTO Notes apps use to connect. The server is reachable
# from the internet through the tunnel, so it's a random secret rather than a
# guessable default. Show it with: ./homelab secret futo-notes
FUTO_NOTES_PASSWORD={{RANDOM}}
