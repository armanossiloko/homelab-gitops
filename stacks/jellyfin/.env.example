# Rendered to .env by ./homelab (see "Placeholders" in README.md).
TZ={{TZ}}

# Persistent Jellyfin state
JELLYFIN_CONFIG={{DATA}}/config
JELLYFIN_CACHE={{DATA}}/cache

# Media folders, mounted read-only at /media/videos and /media/music.
# Edit stacks/jellyfin/.env on a machine to point at other disks.
MEDIA_VIDEOS={{HOME}}/Videos
MEDIA_MUSIC={{HOME}}/Music

# Admin account created automatically on first start (by stacks/jellyfin/post-up).
# Change the password after first login.
JELLYFIN_ADMIN_USER=modulab
JELLYFIN_ADMIN_PASSWORD=modulab
