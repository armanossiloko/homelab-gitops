#!/usr/bin/env bash
# 1. On a fresh install, completes the Jellyfin startup wizard (admin user).
# 2. On every run, makes sure the libraries below exist. Libraries are matched
#    by name; existing ones (including ones you add in the UI) are left alone.
set -euo pipefail

# name | collection type | path inside the container (see compose.yml)
LIBRARIES=(
  "Movies|movies|/media/movies"
  "Shows|tvshows|/media/shows"
  "Cartoons|tvshows|/media/cartoons"
  "Wrestling|movies|/media/wrestling"
)

URL=http://localhost:10001
AUTH='MediaBrowser Client="homelab", Device="bootstrap", DeviceId="homelab-bootstrap", Version="1.0"'
TOKEN=
api() { curl -fsS --max-time 30 -H "Authorization: $AUTH${TOKEN:+, Token=\"$TOKEN\"}" -H 'Content-Type: application/json' "$@"; }

for _ in $(seq 90); do
  [[ $(curl -fsS --max-time 5 "$URL/health" 2>/dev/null) == Healthy ]] && break
  sleep 2
done

if ! api "$URL/System/Info/Public" | grep -q '"StartupWizardCompleted":true'; then
  api -X POST "$URL/Startup/Configuration" \
    -d '{"UICulture":"en-US","MetadataCountryCode":"US","PreferredMetadataLanguage":"en"}'
  api "$URL/Startup/User" >/dev/null # materializes the initial user
  api -X POST "$URL/Startup/User" \
    -d "$(printf '{"Name":"%s","Password":"%s"}' "$JELLYFIN_ADMIN_USER" "$JELLYFIN_ADMIN_PASSWORD")"
  api -X POST "$URL/Startup/RemoteAccess" -d '{"EnableRemoteAccess":true,"EnableAutomaticPortMapping":false}'
  api -X POST "$URL/Startup/Complete"
  echo "created Jellyfin admin $JELLYFIN_ADMIN_USER"
fi

TOKEN=$(api -X POST "$URL/Users/AuthenticateByName" \
  -d "$(printf '{"Username":"%s","Pw":"%s"}' "$JELLYFIN_ADMIN_USER" "$JELLYFIN_ADMIN_PASSWORD")" 2>/dev/null |
  sed -n 's/.*"AccessToken":"\([^"]*\)".*/\1/p') || true
if [[ -z $TOKEN ]]; then
  echo "cannot log in as $JELLYFIN_ADMIN_USER (password changed?); skipping library check" >&2
  exit 0
fi

# Hardware transcoding on the Intel iGPU (Quick Sync). Only applied while it is
# still the default "none", so a choice made later in the UI is kept. The iGPU
# (UHD 630) decodes H.264, HEVC (incl. 10-bit), MPEG-2, VC-1, VP8 and VP9.
if [[ -e /dev/dri/renderD128 ]]; then
  enc=$(api "$URL/System/Configuration/encoding")
  if grep -q '"HardwareAccelerationType":"none"' <<<"$enc"; then
    python3 -c '
import sys, json
c = json.load(sys.stdin)
c.update(HardwareAccelerationType="qsv", VaapiDevice="/dev/dri/renderD128",
         EnableHardwareEncoding=True, EnableVppTonemapping=True,
         EnableDecodingColorDepth10Hevc=True, EnableDecodingColorDepth10Vp9=True,
         HardwareDecodingCodecs=["h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9"])
print(json.dumps(c))' <<<"$enc" | api -X POST "$URL/System/Configuration/encoding" -d @-
    echo "enabled Jellyfin hardware transcoding (Intel Quick Sync)"
  fi
fi

existing=$(api "$URL/Library/VirtualFolders")
for lib in "${LIBRARIES[@]}"; do
  IFS='|' read -r name type path <<<"$lib"
  grep -q "\"Name\":\"$name\"" <<<"$existing" && continue
  api -X POST "$URL/Library/VirtualFolders?name=$name&collectionType=$type&paths=$path&refreshLibrary=true" \
    -d "{\"LibraryOptions\":{\"PathInfos\":[{\"Path\":\"$path\"}]}}"
  echo "added Jellyfin library $name ($path)"
done
