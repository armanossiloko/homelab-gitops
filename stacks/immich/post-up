#!/usr/bin/env bash
# 1. Creates the Immich admin account on a fresh install, and turns on
#    hardware transcoding (Intel Quick Sync) there if the iGPU is present.
#    Later changes made in the UI are left alone.
# 2. Sets Immich's external domain (used in share links) to IMMICH_PUBLIC_URL
#    from homelab.conf, if set.
set -euo pipefail

API=http://localhost:10002/api
for _ in $(seq 90); do
  [[ $(curl -fsS --max-time 5 "$API/server/ping" 2>/dev/null) == *pong* ]] && break
  sleep 2
done

fresh=0
if ! curl -fsS "$API/server/config" | grep -q '"isInitialized":true'; then
  body=$(printf '{"email":"%s","password":"%s","name":"%s"}' \
    "$IMMICH_ADMIN_EMAIL" "$IMMICH_ADMIN_PASSWORD" "${IMMICH_ADMIN_NAME:-admin}")
  curl -fsS -o /dev/null -X POST "$API/auth/admin-sign-up" -H 'Content-Type: application/json' -d "$body"
  echo "created Immich admin $IMMICH_ADMIN_EMAIL"
  fresh=1
fi

qsv=0
[[ $fresh == 1 && -e /dev/dri/renderD128 ]] && qsv=1
current=$(curl -fsS "$API/server/config" | sed -n 's/.*"externalDomain":"\([^"]*\)".*/\1/p')
domain=0
[[ -n ${IMMICH_PUBLIC_URL:-} && $current != "$IMMICH_PUBLIC_URL" ]] && domain=1
# Every login opens a new Immich session, so only log in when there is work.
[[ $qsv == 1 || $domain == 1 ]] || exit 0

token=$(curl -fsS -X POST "$API/auth/login" -H 'Content-Type: application/json' \
  -d "$(printf '{"email":"%s","password":"%s"}' "$IMMICH_ADMIN_EMAIL" "$IMMICH_ADMIN_PASSWORD")" 2>/dev/null |
  sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p') || true
if [[ -z $token ]]; then
  echo "admin password changed, so the external domain can't be set automatically." >&2
  echo "Set it in Administration → Settings → Server → External Domain: $IMMICH_PUBLIC_URL" >&2
  exit 0
fi
curl -fsS -H "Authorization: Bearer $token" "$API/system-config" |
  python3 -c '
import sys, json
c = json.load(sys.stdin)
if sys.argv[1] == "1":
    c["server"]["externalDomain"] = sys.argv[3]
if sys.argv[2] == "1":
    c["ffmpeg"].update(accel="qsv", accelDecode=True)
print(json.dumps(c))' "$domain" "$qsv" "${IMMICH_PUBLIC_URL:-}" |
  curl -fsS -o /dev/null -X PUT "$API/system-config" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' -d @-
[[ $domain == 1 ]] && echo "set Immich external domain to $IMMICH_PUBLIC_URL"
[[ $qsv == 1 ]] && echo "enabled Immich hardware transcoding (Intel Quick Sync)"
exit 0
