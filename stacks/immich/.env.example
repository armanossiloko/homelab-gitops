# Rendered to .env by ./homelab (see "Placeholders" in README.md).
# All variables: https://docs.immich.app/install/environment-variables

# Photo/video library on the SSD (uploads, thumbnails, transcodes, DB dumps)
UPLOAD_LOCATION={{MEDIA}}/images

# Where the Postgres data lives (local disk only, no network shares)
DB_DATA_LOCATION={{DATA}}/postgres

TZ={{TZ}}

# Immich release line to track. Pin e.g. v3.3.6 for fully reproducible installs.
IMMICH_VERSION=v3

# Postgres password (letters and digits only), generated per machine
DB_PASSWORD={{RANDOM}}

# The values below do not need to be changed
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Admin account created automatically on first start (by stacks/immich/post-up).
# Immich logs in with an email address. Change the password after first login.
IMMICH_ADMIN_EMAIL=modulab@modulab
IMMICH_ADMIN_PASSWORD=modulab
IMMICH_ADMIN_NAME=modulab
