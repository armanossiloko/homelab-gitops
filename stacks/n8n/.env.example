# Rendered to .env by ./homelab (see "Placeholders" in README.md).
TZ={{TZ}}

# SQLite database, encryption key and binary data. The key (in config) decrypts
# saved credentials: back it up with the database.
N8N_DATA={{DATA}}

# Shared secret between n8n and its task runners (never typed anywhere).
N8N_RUNNERS_AUTH_TOKEN={{RANDOM}}

# Owner account created automatically on first start (by stacks/n8n/post-up).
# n8n needs an email with a dot in the domain, and a password of 8+ characters
# with a number and an uppercase letter. Change it after first login.
N8N_OWNER_EMAIL=modulab@modulab.lan
N8N_OWNER_PASSWORD=Modulab1
